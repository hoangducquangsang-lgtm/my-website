# ------------------------------------------------------------------
# VietPaw — browser cache for static files (2026-10-12)
# Namecheap (Apache/LiteSpeed) reads this file; _headers is ignored here.
# If the server already has a .htaccess, PASTE this block at the end of it
# instead of replacing the file.
# ------------------------------------------------------------------

<IfModule mod_headers.c>
  # Images, icons, fonts: 30 days. Rename the file when you replace an image.
  <FilesMatch "\.(webp|avif|jpe?g|png|gif|svg|ico|woff2?)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>

  # CSS / JS: 30 days. Pages load them as style.css?v=... — bump ?v= on every edit.
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>

  # PDF catalogue: 7 days
  <FilesMatch "\.pdf$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType text/css "access plus 30 days"
  ExpiresByType application/javascript "access plus 30 days"
  ExpiresByType text/javascript "access plus 30 days"
  ExpiresByType application/pdf "access plus 7 days"
</IfModule>
