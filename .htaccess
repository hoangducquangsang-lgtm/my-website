# ------------------------------------------------------------------
# NOT ACTIVE — GitHub Pages ignores this file.
#
# vietpaw.com is served by GitHub Pages (see CNAME) behind a Cloudflare
# proxy. Apache/LiteSpeed never sees this file, so nothing below has any
# effect on the live site. Kept only in case hosting moves to Apache.
# To change cache or redirect behaviour for real, use the Cloudflare
# dashboard. See AGENTS.md.
#
# VietPaw — browser cache for static files (2026-10-12)
# Written when the plan was to serve from Namecheap cPanel.
# ------------------------------------------------------------------

<IfModule mod_headers.c>
  # Images, icons, fonts: 30 days. Rename the file when you replace an image.
  <FilesMatch "\.(webp|avif|jpe?g|png|gif|svg|ico|woff2?)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>

  # CSS / JS: 30 days. Pages load them as style.css?v=... — bump ?v= on every edit.
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>

  # PDF catalogue: 7 days
  # Video: 30 days
  <FilesMatch "\.(webm|mp4)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>

  <FilesMatch "\.pdf$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>

# LiteSpeed/Apache usually know this type already; declared here to be certain.
<IfModule mod_mime.c>
  AddType video/webm .webm
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType text/css "access plus 30 days"
  ExpiresByType application/javascript "access plus 30 days"
  ExpiresByType text/javascript "access plus 30 days"
  ExpiresByType video/webm "access plus 30 days"
  ExpiresByType application/pdf "access plus 7 days"
</IfModule>


# ------------------------------------------------------------------
# VietPaw — wholesale catalogue page retired (2026-10-29)
# The catalogue is not published to the public; send buyers to the RFQ page.
# ------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^wholesale-catalogue/?$ /request-a-quote/ [R=301,L]
  RewriteRule ^wholesale-catalogue/index\.html$ /request-a-quote/ [R=301,L]
</IfModule>
