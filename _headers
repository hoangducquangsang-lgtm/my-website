# Cache policy (Netlify / Cloudflare Pages read this file)
# Fingerprint-free assets: long cache for images, shorter for CSS/HTML.

# Versioned assets (with cache-busting query strings like ?v=20260930-optimized)
# Can be cached for 1 year since the version changes when content changes
/assets/style.css?v=*
  Cache-Control: public, max-age=31536000, immutable

/assets/*.js?v=*
  Cache-Control: public, max-age=31536000, immutable

# Unversioned assets - use shorter cache and must-revalidate
# This allows us to update non-versioned files without waiting for cache to expire
/assets/style.css
  Cache-Control: public, max-age=86400, must-revalidate

/assets/*.js
  Cache-Control: public, max-age=86400, must-revalidate

# Images - long cache (already have fingerprints or are immutable)
/assets/img/*
  Cache-Control: public, max-age=31536000, immutable

# Downloads - moderate cache (30 days)
/assets/downloads/*
  Cache-Control: public, max-age=2592000

# HTML pages - shorter cache to ensure users get latest content
/*.html
  Cache-Control: public, max-age=86400, must-revalidate

# Homepage - very short cache to ensure fresh content
/
  Cache-Control: public, max-age=3600, must-revalidate
